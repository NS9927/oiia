<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>net.posdaca.oiia</id>

    <name>Oiia</name>

    <vendor url="https://github.com/NS9927/oiia">NS9927</vendor>

    <description>
        Oiia is a beta Hearts of Iron IV modding toolkit built on top of Paradox Language Support.
        It adds visual previews for national focus trees, technology trees, GUI files, and map data.
    </description>

    <depends>com.intellij.modules.platform</depends>
    <depends>icu.windea.pls</depends>

    <resource-bundle>messages.OiiaBundle</resource-bundle>

    <extensions defaultExtensionNs="com.intellij">
        <toolWindow id="NationalFocusPreview" factoryClass="net.posdaca.oiia.focus.NationalFocusPreviewToolWindowFactory"
                    icon="/icons/focusPreview.svg"
                    anchor="right"
                    secondary="true"/>
        <toolWindow id="TechnologyPreview" factoryClass="net.posdaca.oiia.technology.TechnologyPreviewToolWindowFactory"
                    icon="/icons/technologyPreview.svg"
                    anchor="right"
                    secondary="true"/>
        <toolWindow id="GuiPreview" factoryClass="net.posdaca.oiia.gui.GuiPreviewToolWindowFactory"
                    icon="/icons/guiPreview.svg"
                    anchor="right"
                    secondary="true"/>
        <toolWindow id="MapPreview" factoryClass="net.posdaca.oiia.map.MapPreviewToolWindowFactory"
                    icon="/icons/mapPreview.svg"
                    anchor="right"
                    secondary="true"/>
    </extensions>

    <extensions defaultExtensionNs="icu.windea.pls">
        <inferredGameTypeProvider implementation="net.posdaca.oiia.core.HoI4GameTypeProvider"/>
        <quickDocTextProvider implementation="net.posdaca.oiia.focus.NationalFocusQuickDocTextProvider"/>
    </extensions>

</idea-plugin>
